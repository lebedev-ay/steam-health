POSTGRES_DB=steam
POSTGRES_USER=steam
POSTGRES_PASSWORD=change_me
# подпись сессии входа в дашборд: python3 -c "import secrets; print(secrets.token_hex(32))". Без ключа вход и сбор выключены.
# Учётки выдаются руками: docker compose exec web python users.py add <логин>
SECRET_KEY=
# локально по http - 0, иначе браузер не вернёт куку входа; на проде за https не задавать
#COOKIE_SECURE=0

# глубина сбора отзывов из дашборда: сколько дней истории тянуть и предел страниц по 100 отзывов на случай очень шумной игры
#COLLECT_REVIEW_DAYS=365
#COLLECT_REVIEW_PAGES=200
#COLLECT_NEWS_PAGES=10


# LLM-разметка отзывов (python -m llm.label): OpenAI-совместимый адрес, модель, ключ. Для OpenRouter - https://openrouter.ai/api/v1 и qwen/qwen3.8-flash
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# цены за 1 млн токенов, долларов: вход, выход, вход из кэша провайдера (если есть). Без цен вывод пишет «цена неизвестна»
LLM_PRICE_INPUT=
LLM_PRICE_OUTPUT=
LLM_PRICE_INPUT_CACHED=

# airflow
# AIRFLOW_UID - вывод id -u
# AIRFLOW_DB_PASSWORD - openssl rand -hex 16 (только hex: пароль входит в строку подключения)
# AIRFLOW_FERNET_KEY - python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# AIRFLOW_JWT_SECRET - openssl rand -hex 32
AIRFLOW_UID=
AIRFLOW_DB_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_PASSWORD=

# порты на хосте; второй копии проекта на той же машине - другие, например 5434, 5001, 8081
PG_PORT=5433
WEB_PORT=5000
# дашборд слушает только эту машину; 0.0.0.0 - открыть в локальную сеть
WEB_HOST=127.0.0.1
AIRFLOW_PORT=8080
