steam-health.ru {
    # сбор игры защищает вход в самом дашборде (web/auth.py), отдельного пароля на прокси нет

    log {
        output stdout
        format json
    }

    reverse_proxy web:5000
}

airflow.steam-health.ru {
    basic_auth {
        anton {env.CADDY_AIRFLOW_HASH}
    }

    log {
        output stdout
        format json
    }

    reverse_proxy airflow-apiserver:8080
}
